# ---------------------------------------------------------------------------
# EdgeTrack frontend environment (copy to .env.local — never commit real values)
# ---------------------------------------------------------------------------
# If VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY are empty, EdgeTrack runs in
# "local mode": data is kept only in this browser's localStorage.

# Supabase project URL, e.g. https://abcdefghijkl.supabase.co
VITE_SUPABASE_URL=

# Supabase anon / publishable key (safe for the browser; RLS protects data)
VITE_SUPABASE_ANON_KEY=

# Automatically sign out after this many minutes of inactivity (default 60)
VITE_IDLE_TIMEOUT_MINUTES=60

# ---------------------------------------------------------------------------
# Server-side only — used by `npm run create-user`. NEVER prefix with VITE_.
# Provide these in your shell at runtime instead of saving them in a file.
# ---------------------------------------------------------------------------
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# EDGETRACK_USERNAME=
# EDGETRACK_PASSWORD=
# EDGETRACK_EMAIL=
